{%- comment -%}
  Video Playlist — App Embed Block
  Floating widget: card-stack player with controls overlaid on the video.
  No header bar. Transport + progress sit directly on top of the card.
  MP4 videos only.
{%- endcomment -%}

{%- assign widget_enabled  = block.settings.widget_enabled -%}
{%- assign widget_position = block.settings.widget_position | default: 'bottom-left' -%}
{%- assign loop_playlist   = block.settings.loop_playlist -%}
{%- assign accent_color    = block.settings.accent_color | default: '#667eea' -%}

{%- if widget_enabled -%}

<div
  id="avp-root"
  class="avp-root"
  data-position="{{ widget_position }}"
  data-loop="{{ loop_playlist }}"
  data-accent="{{ accent_color }}"
  data-shop="{{ shop.permanent_domain }}"
  role="complementary"
  aria-label="Media playlist widget"
>

  <!-- ── FAB: open / close toggle ─────────────────────────────────────── -->
  <button
    class="avp-fab"
    id="avp-fab"
    aria-expanded="false"
    aria-controls="avp-panel"
    aria-label="Open playlist"
  >
    <svg class="avp-fab-icon avp-fab-icon--music" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 3v10.55A4 4 0 1 0 14 17V7h4V3h-6z"/>
    </svg>
    <svg class="avp-fab-icon avp-fab-icon--close" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="display:none">
      <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
    </svg>
    <div class="avp-fab-equalizer" id="avp-fab-equalizer" style="display:none" aria-hidden="true">
      <span class="avp-eq-bar"></span>
      <span class="avp-eq-bar"></span>
      <span class="avp-eq-bar"></span>
      <span class="avp-eq-bar"></span>
    </div>
  </button>

  <!-- ── Main panel (no header) ───────────────────────────────────────── -->
  <div class="avp-panel" id="avp-panel" aria-hidden="true">

    <!-- Card-stack stage — cards injected by JS -->
    <div class="avp-stage" id="avp-stage" aria-live="polite" aria-atomic="true">

      <!-- Loading / empty state -->
      <div class="avp-empty" id="avp-empty">
        <div class="avp-spinner"></div>
        <span>Loading…</span>
      </div>

      <!-- Mute toast notification — inside stage so it overlays the video -->
      <div class="avp-mute-toast" id="avp-mute-toast" aria-live="polite" aria-atomic="true" style="display:none">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="avp-mute-toast__icon">
          <path d="M16.5 12A4.5 4.5 0 0 0 14 7.97v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3 3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06a8.99 8.99 0 0 0 3.69-1.81L19.73 21 21 19.73 4.27 3zM12 4 9.91 6.09 12 8.18V4z"/>
        </svg>
        <span class="avp-mute-toast__text">Tap anywhere to unmute 🔊</span>
      </div>

      <!-- ── Controls overlay — sit on top of the video ────────────────── -->
      <div class="avp-overlay-controls" id="avp-overlay-controls">

        <!-- Track info (title + type badge) -->
        <div class="avp-overlay-info" id="avp-overlay-info" style="display:none">
          <span class="avp-overlay-badge" id="avp-overlay-badge"></span>
          <span class="avp-overlay-title" id="avp-overlay-title"></span>
        </div>

        <!-- Transport row -->
        <div class="avp-transport" role="group" aria-label="Player controls">
          <button class="avp-btn avp-btn--prev" id="avp-prev" aria-label="Previous" disabled>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 6h2v12H6zm3.5 6 8.5 6V6z"/></svg>
          </button>

          <button class="avp-btn avp-btn--play" id="avp-play" aria-label="Play" disabled>
            <svg class="avp-play-icon"  viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
            <svg class="avp-pause-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="display:none"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
          </button>

          <button class="avp-btn avp-btn--next" id="avp-next" aria-label="Next" disabled>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 18 14.5 12 6 6v12zM16 6v12h2V6h-2z"/></svg>
          </button>

          <button class="avp-btn avp-btn--mute" id="avp-mute" aria-label="Mute" aria-pressed="false">
            <svg class="avp-vol-icon"  viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0 0 14 7.97v8.05c1.48-.73 2.5-2.25 2.5-4.02z"/></svg>
            <svg class="avp-mute-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="display:none"><path d="M16.5 12A4.5 4.5 0 0 0 14 7.97v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3 3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06a8.99 8.99 0 0 0 3.69-1.81L19.73 21 21 19.73 4.27 3zM12 4 9.91 6.09 12 8.18V4z"/></svg>
          </button>
        </div>

        <!-- Progress + time -->
        <div class="avp-progress-wrap">
          <div class="avp-progress" id="avp-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
            <div class="avp-progress__fill" id="avp-progress-fill"></div>
            <input type="range" class="avp-progress__input" id="avp-seek" min="0" max="100" value="0" step="0.1" aria-label="Seek">
          </div>
          <span class="avp-time" id="avp-time" aria-live="off">0:00 / 0:00</span>
        </div>

      </div><!-- /avp-overlay-controls -->
    </div><!-- /avp-stage -->

    <!-- Playlist drawer -->
    <div class="avp-drawer" id="avp-drawer" aria-label="Playlist">
      <button class="avp-drawer__toggle" id="avp-drawer-toggle" aria-expanded="false" aria-controls="avp-track-list">
        <span class="avp-drawer__label">Playlist</span>
        <svg class="avp-drawer__chevron" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M7.41 8.59 12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"/>
        </svg>
      </button>
      <ul class="avp-track-list" id="avp-track-list" role="list" aria-label="Tracks"></ul>
    </div>

  </div><!-- /avp-panel -->
</div><!-- /avp-root -->

{{ 'playlist-widget.css' | asset_url | stylesheet_tag }}
<script src="{{ 'playlist-widget.js' | asset_url }}" defer></script>

{%- endif -%}

{% schema %}
{
  "name": "Video Playlist",
  "target": "body",
  "settings": [
    {
      "type": "header",
      "content": "Widget"
    },
    {
      "type": "checkbox",
      "id": "widget_enabled",
      "label": "Enable playlist widget",
      "default": true,
      "info": "Show the floating playlist on all storefront pages."
    },
    {
      "type": "select",
      "id": "widget_position",
      "label": "Position",
      "options": [
        { "label": "Bottom left",  "value": "bottom-left"  },
        { "label": "Bottom right", "value": "bottom-right" },
        { "label": "Top left",     "value": "top-left"     },
        { "label": "Top right",    "value": "top-right"    }
      ],
      "default": "bottom-left"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent colour",
      "default": "#667eea",
      "info": "Used for the play button and progress bar."
    },
    {
      "type": "header",
      "content": "Playback"
    },
    {
      "type": "checkbox",
      "id": "loop_playlist",
      "label": "Loop playlist",
      "default": true,
      "info": "Return to the first video after the last one finishes."
    }
  ]
}
{% endschema %}
